#
# Logic Boole 16, board revision C: the pin constraints of the FPGA, an XC6SLX9-2TQG144C, and its clocks.
# Banks 0 and 3 are at 3.3 V, banks 1 and 2 at 1.8 V (the FX3's GPIF II bus and the configuration pins).
CONFIG VCCAUX = "3.3";

NET "clk24" LOC = "P132" | IOSTANDARD = LVCMOS33;    # IO_L35P_GCLK17_0, bank 0
NET "dbg<0>" LOC = "P124" | IOSTANDARD = LVCMOS33;    # IO_L37P_GCLK13_0, bank 0
NET "dbg<1>" LOC = "P126" | IOSTANDARD = LVCMOS33;    # IO_L36N_GCLK14_0, bank 0
NET "dbg<2>" LOC = "P127" | IOSTANDARD = LVCMOS33;    # IO_L36P_GCLK15_0, bank 0
NET "dbg<3>" LOC = "P131" | IOSTANDARD = LVCMOS33;    # IO_L35N_GCLK16_0, bank 0
NET "fx3_scl" LOC = "P111" | IOSTANDARD = LVCMOS33;    # IO_L66N_SCP0_0, bank 0
NET "fx3_sda" LOC = "P112" | IOSTANDARD = LVCMOS33;    # IO_L66P_SCP1_0, bank 0
NET "pif_gpio10" LOC = "P118" | IOSTANDARD = LVCMOS33;    # IO_L63N_SCP6_0, bank 0
NET "pif_gpio11" LOC = "P120" | IOSTANDARD = LVCMOS33;    # IO_L62N_VREF_0, bank 0
NET "pif_gpio14" LOC = "P116" | IOSTANDARD = LVCMOS33;    # IO_L64N_SCP4_0, bank 0
NET "pif_gpio15" LOC = "P117" | IOSTANDARD = LVCMOS33;    # IO_L64P_SCP5_0, bank 0
NET "pif_gpio2" LOC = "P114" | IOSTANDARD = LVCMOS33;    # IO_L65N_SCP2_0, bank 0
NET "pif_gpio3" LOC = "P115" | IOSTANDARD = LVCMOS33;    # IO_L65P_SCP3_0, bank 0
NET "pif_gpio7" LOC = "P123" | IOSTANDARD = LVCMOS33;    # IO_L37N_GCLK12_0, bank 0
NET "pif_gpio8" LOC = "P121" | IOSTANDARD = LVCMOS33;    # IO_L62P_0, bank 0
NET "pif_gpio9" LOC = "P119" | IOSTANDARD = LVCMOS33;    # IO_L63P_SCP7_0, bank 0
NET "fx3_ctl11" LOC = "P80" | IOSTANDARD = LVCMOS18;    # IO_L46N_1, bank 1
NET "fx3_ctl12" LOC = "P79" | IOSTANDARD = LVCMOS18;    # IO_L47P_1, bank 1
NET "fx3_ctl2" LOC = "P75" | IOSTANDARD = LVCMOS18;    # IO_L74P_AWAKE_1, bank 1
NET "fx3_ctl5" LOC = "P74" | IOSTANDARD = LVCMOS18;    # IO_L74N_DOUT_BUSY_1, bank 1
NET "fx3_ctl6" LOC = "P78" | IOSTANDARD = LVCMOS18;    # IO_L47N_1, bank 1
NET "fx3_ctl8" LOC = "P95" | IOSTANDARD = LVCMOS18;    # IO_L40P_GCLK11_1, bank 1
NET "fx3_dq<16>" LOC = "P82" | IOSTANDARD = LVCMOS18;    # IO_L45N_1, bank 1
NET "fx3_dq<17>" LOC = "P87" | IOSTANDARD = LVCMOS18;    # IO_L42N_GCLK6_TRDY1_1, bank 1
NET "fx3_dq<18>" LOC = "P83" | IOSTANDARD = LVCMOS18;    # IO_L45P_1, bank 1
NET "fx3_dq<19>" LOC = "P84" | IOSTANDARD = LVCMOS18;    # IO_L43N_GCLK4_1, bank 1
NET "fx3_dq<20>" LOC = "P81" | IOSTANDARD = LVCMOS18;    # IO_L46P_1, bank 1
NET "fx3_dq<21>" LOC = "P85" | IOSTANDARD = LVCMOS18;    # IO_L43P_GCLK5_1, bank 1
NET "fx3_dq<22>" LOC = "P93" | IOSTANDARD = LVCMOS18;    # IO_L41P_GCLK9_IRDY1_1, bank 1
NET "fx3_dq<23>" LOC = "P92" | IOSTANDARD = LVCMOS18;    # IO_L41N_GCLK8_1, bank 1
NET "fx3_dq<24>" LOC = "P98" | IOSTANDARD = LVCMOS18;    # IO_L34P_1, bank 1
NET "fx3_dq<25>" LOC = "P99" | IOSTANDARD = LVCMOS18;    # IO_L33N_1, bank 1
NET "fx3_dq<26>" LOC = "P94" | IOSTANDARD = LVCMOS18;    # IO_L40N_GCLK10_1, bank 1
NET "fx3_dq<27>" LOC = "P97" | IOSTANDARD = LVCMOS18;    # IO_L34N_1, bank 1
NET "fx3_dq<28>" LOC = "P100" | IOSTANDARD = LVCMOS18;    # IO_L33P_1, bank 1
NET "fx3_dq<29>" LOC = "P101" | IOSTANDARD = LVCMOS18;    # IO_L32N_1, bank 1
NET "fx3_dq<30>" LOC = "P104" | IOSTANDARD = LVCMOS18;    # IO_L1N_VREF_1, bank 1
NET "fx3_dq<31>" LOC = "P102" | IOSTANDARD = LVCMOS18;    # IO_L32P_1, bank 1
NET "fx3_pclk" LOC = "P88" | IOSTANDARD = LVCMOS18;    # IO_L42P_GCLK7_1, bank 1
NET "fx3_ctl0" LOC = "P59" | IOSTANDARD = LVCMOS18;    # IO_L13N_D10_2, bank 2
NET "fx3_ctl1" LOC = "P66" | IOSTANDARD = LVCMOS18;    # IO_L2N_CMPMOSI_2, bank 2
NET "fx3_ctl3" LOC = "P67" | IOSTANDARD = LVCMOS18;    # IO_L2P_CMPCLK_2, bank 2
NET "fx3_ctl4" LOC = "P64" | IOSTANDARD = LVCMOS18;    # IO_L3N_MOSI_CSI_B_MISO0_2, bank 2
NET "fx3_ctl7" LOC = "P62" | IOSTANDARD = LVCMOS18;    # IO_L12P_D1_MISO2_2, bank 2
NET "fx3_dq<0>" LOC = "P38" | IOSTANDARD = LVCMOS18;    # IO_L65N_CSO_B_2, bank 2
NET "fx3_dq<1>" LOC = "P40" | IOSTANDARD = LVCMOS18;    # IO_L64N_D9_2, bank 2
NET "fx3_dq<2>" LOC = "P44" | IOSTANDARD = LVCMOS18;    # IO_L62P_D5_2, bank 2
NET "fx3_dq<3>" LOC = "P43" | IOSTANDARD = LVCMOS18;    # IO_L62N_D6_2, bank 2
NET "fx3_dq<4>" LOC = "P46" | IOSTANDARD = LVCMOS18;    # IO_L49P_D3_2, bank 2
NET "fx3_dq<5>" LOC = "P41" | IOSTANDARD = LVCMOS18;    # IO_L64P_D8_2, bank 2
NET "fx3_dq<6>" LOC = "P45" | IOSTANDARD = LVCMOS18;    # IO_L49N_D4_2, bank 2
NET "fx3_dq<7>" LOC = "P47" | IOSTANDARD = LVCMOS18;    # IO_L48N_RDWR_B_VREF_2, bank 2
NET "fx3_dq<8>" LOC = "P50" | IOSTANDARD = LVCMOS18;    # IO_L31N_GCLK30_D15_2, bank 2
NET "fx3_dq<9>" LOC = "P58" | IOSTANDARD = LVCMOS18;    # IO_L14P_D11_2, bank 2
NET "fx3_dq<10>" LOC = "P51" | IOSTANDARD = LVCMOS18;    # IO_L31P_GCLK31_D14_2, bank 2
NET "fx3_dq<11>" LOC = "P56" | IOSTANDARD = LVCMOS18;    # IO_L30P_GCLK1_D13_2, bank 2
NET "fx3_dq<12>" LOC = "P55" | IOSTANDARD = LVCMOS18;    # IO_L30N_GCLK0_USERCCLK_2, bank 2
NET "fx3_dq<13>" LOC = "P57" | IOSTANDARD = LVCMOS18;    # IO_L14N_D12_2, bank 2
NET "fx3_dq<14>" LOC = "P61" | IOSTANDARD = LVCMOS18;    # IO_L12N_D2_MISO3_2, bank 2
NET "fx3_dq<15>" LOC = "P48" | IOSTANDARD = LVCMOS18;    # IO_L48P_D7_2, bank 2
NET "cha<0>" LOC = "P15" | IOSTANDARD = LVCMOS33;    # IO_L44P_GCLK21_3, bank 3
NET "cha<1>" LOC = "P14" | IOSTANDARD = LVCMOS33;    # IO_L44N_GCLK20_3, bank 3
NET "cha<2>" LOC = "P12" | IOSTANDARD = LVCMOS33;    # IO_L49P_3, bank 3
NET "cha<3>" LOC = "P11" | IOSTANDARD = LVCMOS33;    # IO_L49N_3, bank 3
NET "cha<4>" LOC = "P10" | IOSTANDARD = LVCMOS33;    # IO_L50P_3, bank 3
NET "cha<5>" LOC = "P9" | IOSTANDARD = LVCMOS33;    # IO_L50N_3, bank 3
NET "cha<6>" LOC = "P8" | IOSTANDARD = LVCMOS33;    # IO_L51P_3, bank 3
NET "cha<7>" LOC = "P7" | IOSTANDARD = LVCMOS33;    # IO_L51N_3, bank 3
NET "chb<0>" LOC = "P24" | IOSTANDARD = LVCMOS33;    # IO_L41P_GCLK27_3, bank 3
NET "chb<1>" LOC = "P30" | IOSTANDARD = LVCMOS33;    # IO_L36P_3, bank 3
NET "chb<2>" LOC = "P29" | IOSTANDARD = LVCMOS33;    # IO_L36N_3, bank 3
NET "chb<3>" LOC = "P27" | IOSTANDARD = LVCMOS33;    # IO_L37P_3, bank 3
NET "chb<4>" LOC = "P26" | IOSTANDARD = LVCMOS33;    # IO_L37N_3, bank 3
NET "chb<5>" LOC = "P23" | IOSTANDARD = LVCMOS33;    # IO_L41N_GCLK26_3, bank 3
NET "chb<6>" LOC = "P22" | IOSTANDARD = LVCMOS33;    # IO_L42P_GCLK25_TRDY2_3, bank 3
NET "chb<7>" LOC = "P21" | IOSTANDARD = LVCMOS33;    # IO_L42N_GCLK24_3, bank 3
NET "led_arm" LOC = "P5" | IOSTANDARD = LVCMOS33;    # IO_L52N_3, bank 3
NET "led_trig" LOC = "P6" | IOSTANDARD = LVCMOS33;    # IO_L52P_3, bank 3
NET "pwm_a" LOC = "P1" | IOSTANDARD = LVCMOS33;    # IO_L83N_VREF_3, bank 3
NET "pwm_b" LOC = "P2" | IOSTANDARD = LVCMOS33;    # IO_L83P_3, bank 3
NET "trig_in" LOC = "P16" | IOSTANDARD = LVCMOS33;    # IO_L43N_GCLK22_IRDY2_3, bank 3
NET "trig_out" LOC = "P17" | IOSTANDARD = LVCMOS33;    # IO_L43P_GCLK23_3, bank 3

NET "clk24" TNM_NET = "clk24";
TIMESPEC "TS_clk24" = PERIOD "clk24" 41.667 ns HIGH 50%;
NET "fx3_pclk" TNM_NET = "fx3_pclk";
TIMESPEC "TS_fx3_pclk" = PERIOD "fx3_pclk" 10.000 ns HIGH 50%;
