	(text "CC1 / CC2: 5.1k Rd each (sink).  D+/D- of both rows go to the FX3's USB 2.0 port; the SuperSpeed pairs of both\norientations go to the orientation switch.  TX1 / TX2 are the board's transmit pairs.  VBUS: SMF5.0A TVS."
		(exclude_from_sim no)
		(at 15 31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0109b057-b698-5e3e-8fef-d60cbc5063b5")
	)
	(text "2  USB-C: receptacle, ESD, orientation detect, SuperSpeed orientation switch"
		(exclude_from_sim no)
		(at 15 14 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "0256721c-e20c-5f5f-bfc6-a2706759e76e")
	)
	(text "SuperSpeed orientation switch (HD3SS3212, second source PI3USB302-A)"
		(exclude_from_sim no)
		(at 386.239 25.2 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "04503456-cf99-538b-a19a-917acfcec2f6")
	)
	(text "Plug orientation detect"
		(exclude_from_sim no)
		(at 223.863 25.2 0)
		(effects
