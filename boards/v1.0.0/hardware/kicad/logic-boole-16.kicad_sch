	(text "Sheets: 1 power - 2 USB-C - 3 FX3 - 4 FPGA - 5 pod A - 6 pod B - 7 thresholds, clamp rail and trigger - 8 Raspberry Pi HAT+"
		(exclude_from_sim no)
		(at 15 68.3 0)
		(effects
			(font
				(face "Courier New")
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "61809b95-a8e0-50b6-8412-40599bfe3e22")
	)
	(text "  Pod A 8 ch --+                                             GPIF II, 32 bit, 100 MHz, 1.8 V\n  Pod B 8 ch --+--> 5:1 divider -> TLV3502 comparator --> XC6SLX9-2TQG144C <=================> FX3 (CYUSB3014) --> orientation switch --> USB-C\n  threshold per pod: FPGA PWM -> 2.5 V reference -> filter -> buffer --+  ^  ^   slave-serial configuration, I2C       |  USB 2.0 ------------+\n  TRIG IN / TRIG OUT (3-pin header) -------------------------------------+  |                                          +-- 19.2 MHz crystal\n  24 MHz oscillator (timebase) ----------------------------------------------+   Pi I2C / SPI / UART (optional jumpers) <-- 40-pin stacking header"
		(exclude_from_sim no)
		(at 15 37.4 0)
		(effects
			(font
				(face "Courier New")
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "776dea00-ea4d-5055-ba15-482b6dfb9230")
	)
	(text "  USB-C VBUS --+--> ideal diodes --> +5V --> 3.3 V and 1.2 V bucks (on while the Pi's 3.3 V or VBUS is present) --> 1.8 V LDO\n  Pi 5 V ------+                                                                 HAT+ ID EEPROM (0x51, Stackable) on ID_SD / ID_SC"
		(exclude_from_sim no)
		(at 15 56.9 0)
		(effects
			(font
				(face "Courier New")
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "781d1544-1532-5423-89d2-d07101299be3")
	)
	(text "16-channel, 200 MS/s digital logic analyzer, revision C - USB 3 to a PC, or a Raspberry Pi HAT+ that streams to the Pi over a short USB cable\n-----------------------------------------------------------------------------------------------------------------------------------------"
		(exclude_from_sim no)
		(at 15 26 0)
		(effects
			(font
				(face "Courier New")
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "9a4d4cc9-5aa8-52ab-827f-8162b210eebd")
	)
