"""Runs the host software from this folder, with nothing installed:  ./logicboole  or  ./logicboole capture x.sr"""
import os
import sys

if sys.version_info < (3, 9):
    sys.exit("logicboole needs Python 3.9 or later; this is Python %d.%d." % sys.version_info[:2])
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "software"))
from logicboole.cli import main  # noqa: E402

sys.exit(main())
